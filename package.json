{
  "name": "shiye-gallery",
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "node build.js",
    "build:fast": "node build.js --skip-screenshots",
    "dev": "node scripts/dev.js",
    "preview": "node scripts/dev.js --no-build",
    "check": "node scripts/content.js check",
    "test": "node --test tests/*.test.js",
    "deploy": "bash scripts/deploy.sh",
    "thumbnails": "node build.js --refresh-thumbs",
    "setup:browser": "node scripts/install-chromium.js",
    "fonts:fetch": "bash scripts/fetch-fonts.sh"
  },
  "devDependencies": {
    "playwright": "^1.45.0",
    "subset-font": "^2.9.0"
  }
}
